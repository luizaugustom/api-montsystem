# Local development environment variables
# Use this when running the API locally (npm run start:dev).
# Points to the host machine's Docker network on Windows (Docker Desktop).
# Postgres está mapeado para a porta 5432 do host; localhost funciona melhor em muitas configurações Windows
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=montsystem
DATABASE_HOST=localhost
# JWT_SECRET used in local development
JWT_SECRET=dev-secret-montsystem
PORT=3001
