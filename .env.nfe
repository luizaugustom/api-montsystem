# Configurações SEFAZ/NFe
NFE_ENVIRONMENT=homologacao # homologacao ou producao
NFE_UF=SP # Estado emissor
NFE_TIMEOUT=30000 # Timeout em ms para webservices

# Empresa emissora
COMPANY_CNPJ=12345678000195
COMPANY_IE=123456789
COMPANY_NAME=MONT SYSTEM LTDA
COMPANY_FANTASY=Mont System
COMPANY_CRT=3 # 1=Simples Nacional, 2=Simples Nacional - excesso, 3=Regime Normal
COMPANY_ADDRESS=Rua das Empresas, 123
COMPANY_NUMBER=123
COMPANY_NEIGHBORHOOD=Centro
COMPANY_CEP=01234567
COMPANY_CITY=São Paulo
COMPANY_CITY_CODE=3550308
COMPANY_STATE=SP
COMPANY_PHONE=1133334444
COMPANY_EMAIL=nfe@montsystem.com

# Certificado Digital (A1 - arquivo .pfx)
CERT_PATH=./certs/certificado.pfx
CERT_PASSWORD=senha_do_certificado

# Email para envio de NFe
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nfe@montsystem.com
SMTP_PASS=senha_email

# Série e numeração
NFE_SERIES=1
NFE_LAST_NUMBER=0 # Último número usado (será incrementado automaticamente)

# Configurações opcionais
NFE_LOGO_PATH=./assets/logo.png
NFE_DANFE_TEMPLATE=./templates/danfe.html