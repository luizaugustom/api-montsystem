# =============================================================================
# Mont System — variáveis de ambiente
# =============================================================================
# Este é o ÚNICO arquivo de env do projeto. O main.ts carrega este arquivo
# (ou `.env` se preferir renomear) na inicialização.
#
# Tudo que ficar vazio aqui pode ser preenchido pela tela `/integracoes`
# e gravado em `storage/config/integrations.json` — o storage JSON tem
# prioridade sobre o env na hora de montar a config final.
#
# Os valores abaixo são defaults seguros para dev local (`npm run start:dev`).
# Para rodar dentro do Docker Compose, troque:
#   DATABASE_HOST=localhost           →  DATABASE_HOST=db
#   NOTIFICATION_URL=http://localhost:4000/events → http://notification:4000/events
#   EVOLUTION_BASE_URL=http://localhost:8080       → http://evolution:8080
# =============================================================================

# ---- Banco de dados / Auth ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=montsystem
DATABASE_HOST=localhost
PORT=3001

# ---- JWT ----
# OBRIGATÓRIO. A API não sobe sem esta env. Use uma string aleatória longa em
# produção (ex: `openssl rand -base64 48`). Rotacionar este valor invalida
# TODAS as sessões existentes imediatamente.
JWT_SECRET=

# ---- Bootstrap do primeiro admin ----
# Lidos APENAS no primeiro boot, quando a tabela `users` está vazia. Se já
# existem usuários cadastrados, estas envs são ignoradas — para criar novos
# admins use a tela /usuarios (ou INSERT direto no banco). Para trocar a senha
# de um admin existente, use a mesma tela (qualquer admin pode editar outro).
#
# Em produção: defina um valor forte aqui APENAS no primeiro deploy e troque
# a senha imediatamente no primeiro login (a UI não obriga, mas é o caminho
# correto). Senhas são armazenadas com bcrypt (cost 10).
ADMIN_USER=luiz
ADMIN_PASSWORD=

NOTIFICATION_URL=http://localhost:4000/events

# ---- Unimake (boletos Sicoob 756) ----
# O número do banco (756) pode ser alterado se trocar de banco, mas a Unimake
# mantém os dados de agência/conta/convenio por provedor.
UNIMAKE_API_URL=https://api.unimake.com.br
UNIMAKE_API_KEY=
UNIMAKE_BANCO=756
UNIMAKE_AGENCIA=
UNIMAKE_CONTA=
UNIMAKE_CONVENIO=
UNIMAKE_CARTEIRA=1
UNIMAKE_ESPECIE=R$
UNIMAKE_INSTRUCOES=Não receber após vencimento
UNIMAKE_WEBHOOK_SECRET=
UNIMAKE_MULTA_PERCENT=2
UNIMAKE_JUROS_PERCENT=1

# ---- Focus NFe (NFSe de serviço) ----
# Ambiente: 'homologacao' para testes, 'producao' para emissão com valor fiscal.
# FOCUS_NFE_AUTOMATICO_NO_PAGAMENTO=true → emite NFSe automaticamente ao
# confirmar o pagamento de uma mensalidade.
FOCUS_NFE_BASE_URL=https://api.focusnfe.com.br
FOCUS_NFE_TOKEN=
FOCUS_NFE_AMBIENTE=homologacao
FOCUS_NFE_REF_PADRAO=montsystem
FOCUS_NFE_AUTOMATICO_NO_PAGAMENTO=true

# ---- Resend (email transacional) ----
# Domínio do `from` precisa estar verificado em https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM=Mont System <noreply@montsystem.com>

# ---- Evolution API (WhatsApp) ----
# Serviço externo (open-source) que conecta o WhatsApp Web.
# Em Docker Compose, normalmente o serviço se chama "evolution" — use
#   EVOLUTION_BASE_URL=http://evolution:8080 nesse caso.
# Em produção externa, aponte para a URL pública da instância.
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=montsystem
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# ---- DigitalOcean Spaces (storage de anexos de chamados) ----
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=montsystem-chamados
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
DO_SPACES_PUBLIC_URL=https://montsystem.nyc3.cdn.digitaloceanspaces.com
DO_SPACES_KEY_PREFIX=tickets
